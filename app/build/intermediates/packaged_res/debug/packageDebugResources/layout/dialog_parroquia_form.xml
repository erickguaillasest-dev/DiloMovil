<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTituloDialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva Parroquia"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nombre de la Parroquia *"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombreParroquiaDialog"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/ic_categories"
            android:hint="Ej: Tarqui, Turi, Yanuncay..."
            android:inputType="textCapWords"
            android:paddingHorizontal="14dp"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarDialog"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="#475569"
                android:textSize="16sp"
                app:strokeColor="#CBD5E1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarDialog"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="Registrar Parroquia"
                android:textAllCaps="false"
                app:backgroundTint="#7C3AED" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>