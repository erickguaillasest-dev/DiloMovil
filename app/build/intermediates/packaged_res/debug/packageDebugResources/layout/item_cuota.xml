<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F8FAFC"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tvNumeroCuota"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Cuota #1"
        android:textColor="#0F172A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVencimientoCuota"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:text="25/08/2026"
        android:textColor="#64748B"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMontoCuota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$218.50"
            android:textColor="#0F172A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSaldoCuota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pend: $0.00"
            android:textColor="#64748B"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEstadoCuota"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="PAGADA"
        android:textSize="9sp"
        android:textStyle="bold" />
</LinearLayout>