<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TARJETA CONTENEDORA PRINCIPAL CON BORDES REDONDEADOS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ENCABEZADO OSCURO CON BOTÓN REGRESAR -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:background="#121D33">

                    <ImageButton
                        android:id="@+id/btnVolver"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="start|top"
                        android:layout_margin="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Regresar"
                        android:padding="12dp"
                        android:src="@android:drawable/ic_menu_revert"
                        app:tint="#FFFFFF" />
                </FrameLayout>

                <!-- AVATAR CENTRADO CON BOTÓN EDITABLE DE CÁMARA -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="-50dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/dlgImgAvatar"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:scaleType="centerCrop"
                        android:src="@android:color/darker_gray"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:strokeColor="#FFFFFF"
                        app:strokeWidth="4dp" />

                    <!-- BOTÓN FLOTANTE DE CÁMARA -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnDlgCambiarFoto"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="bottom|end"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#EA580C"
                        app:cardCornerRadius="17dp"
                        app:cardElevation="4dp"
                        app:strokeColor="#FFFFFF"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="#FFFFFF" />
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <!-- CONTENIDO DEL FORMULARIO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- BLOQUE DE NOMBRES -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:hint="Primer Nombre"
                            android:textColorHint="#64748B"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="#CBD5E1"
                            app:boxStrokeWidth="1dp"
                            app:hintTextColor="#EA580C">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/dlgPrimerNombre"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPersonName"
                                android:paddingVertical="10dp"
                                android:textColor="#0F172A"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:hint="Segundo Nombre"
                            android:textColorHint="#64748B"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="#CBD5E1"
                            app:boxStrokeWidth="1dp"
                            app:hintTextColor="#EA580C">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/dlgSegundoNombre"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPersonName"
                                android:paddingVertical="10dp"
                                android:textColor="#0F172A"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- BLOQUE DE APELLIDOS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:hint="Primer Apellido"
                            android:textColorHint="#64748B"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="#CBD5E1"
                            app:boxStrokeWidth="1dp"
                            app:hintTextColor="#EA580C">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/dlgPrimerApellido"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPersonName"
                                android:paddingVertical="10dp"
                                android:textColor="#0F172A"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:hint="Apellido Materno"
                            android:textColorHint="#64748B"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="#CBD5E1"
                            app:boxStrokeWidth="1dp"
                            app:hintTextColor="#EA580C">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/dlgSegundoApellido"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPersonName"
                                android:paddingVertical="10dp"
                                android:textColor="#0F172A"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- FILA 1: CORREO Y TELÉFONO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- CORREO ELECTRÓNICO (LECTURA) -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#E2E8F0"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="12dp">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    app:cardBackgroundColor="#FFF7ED"
                                    app:cardCornerRadius="10dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:src="@android:drawable/ic_dialog_email"
                                        app:tint="#EA580C" />
                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="CORREO ELECTRÓNICO"
                                        android:textColor="#94A3B8"
                                        android:textSize="8sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/dlgCorreo"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:text="castroelkin41@gmail.com"
                                        android:textColor="#0F172A"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- TELÉFONO EDITABLE -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#E2E8F0"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="12dp">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    app:cardBackgroundColor="#FFF7ED"
                                    app:cardCornerRadius="10dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:src="@android:drawable/ic_menu_call"
                                        app:tint="#EA580C" />
                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="TELÉFONO"
                                        android:textColor="#94A3B8"
                                        android:textSize="8sp"
                                        android:textStyle="bold" />

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/dlgTelefono"
                                        android:layout_width="match_parent"
                                        android:layout_height="36dp"
                                        android:layout_marginTop="2dp"
                                        android:background="@null"
                                        android:inputType="phone"
                                        android:paddingHorizontal="4dp"
                                        android:paddingVertical="4dp"
                                        android:text="0991234567"
                                        android:textColor="#0F172A"
                                        android:textColorHint="#94A3B8"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- FILA 2: FECHA NACIMIENTO Y DIRECCIÓN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- FECHA NACIMIENTO -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#E2E8F0"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="12dp">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    app:cardBackgroundColor="#FFF7ED"
                                    app:cardCornerRadius="10dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:src="@android:drawable/ic_menu_my_calendar"
                                        app:tint="#EA580C" />
                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="FECHA DE NACIMIENTO"
                                        android:textColor="#94A3B8"
                                        android:textSize="8sp"
                                        android:textStyle="bold" />

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/dlgFechaNac"
                                        android:layout_width="match_parent"
                                        android:layout_height="36dp"
                                        android:layout_marginTop="2dp"
                                        android:background="@null"
                                        android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                                        android:focusable="false"
                                        android:paddingHorizontal="4dp"
                                        android:paddingVertical="4dp"
                                        android:text="18/07/2002"
                                        android:textColor="#0F172A"
                                        android:textColorHint="#94A3B8"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- DIRECCIÓN -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#E2E8F0"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="12dp">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    app:cardBackgroundColor="#FFF7ED"
                                    app:cardCornerRadius="10dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:src="@android:drawable/ic_menu_mylocation"
                                        app:tint="#EA580C" />
                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="DIRECCIÓN"
                                        android:textColor="#94A3B8"
                                        android:textSize="8sp"
                                        android:textStyle="bold" />

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/dlgDireccion"
                                        android:layout_width="match_parent"
                                        android:layout_height="36dp"
                                        android:layout_marginTop="2dp"
                                        android:background="@null"
                                        android:paddingHorizontal="4dp"
                                        android:paddingVertical="4dp"
                                        android:text="Cuenca"
                                        android:textColor="#0F172A"
                                        android:textColorHint="#94A3B8"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- FILA 3: PARROQUIA DE RESIDENCIA -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#E2E8F0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                app:cardBackgroundColor="#FFF7ED"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@android:drawable/ic_menu_mapmode"
                                    app:tint="#EA580C" />
                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="PARROQUIA DE RESIDENCIA"
                                    android:textColor="#94A3B8"
                                    android:textSize="8sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/dlgParroquia"
                                    android:layout_width="match_parent"
                                    android:layout_height="36dp"
                                    android:layout_marginTop="2dp"
                                    android:background="@null"
                                    android:paddingHorizontal="4dp"
                                    android:paddingVertical="4dp"
                                    android:text="Tarqui"
                                    android:textColor="#0F172A"
                                    android:textColorHint="#94A3B8"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- NUEVA CONTRASEÑA -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Nueva Contraseña (Opcional)"
                        android:textColorHint="#64748B"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#CBD5E1"
                        app:boxStrokeWidth="1dp"
                        app:endIconMode="password_toggle"
                        app:hintTextColor="#EA580C">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/dlgContrasena"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:paddingVertical="10dp"
                            android:textColor="#0F172A"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- LÍNEA DIVISORA -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="16dp"
                        android:background="#E2E8F0" />

                    <!-- BOTONES DE ACCIÓN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelar"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="Cancelar"
                            android:textAllCaps="false"
                            android:textColor="#64748B"
                            app:cornerRadius="12dp"
                            app:strokeColor="#CBD5E1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGuardar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="#EA580C"
                            android:text="Guardar"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>