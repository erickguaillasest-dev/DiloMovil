<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TARJETA CONTENEDORA PRINCIPAL CON BORDES REDONDEADOS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ENCABEZADO OSCURO CON TÍTULO Y BOTÓN DE CERRAR -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="#121D33"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|top"
                        android:layout_marginTop="2dp"
                        android:text="Nuevo Ajuste Manual"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnCerrarModal"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="end|top"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Cerrar"
                        android:padding="6dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="#94A3B8" />
                </FrameLayout>

                <!-- INSIGNIA CIRCULAR CENTRAL DE ENCABEZADO -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="-45dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:background="#F1F5F9"
                        android:padding="22dp"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_menu_edit"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:strokeColor="#FFFFFF"
                        app:strokeWidth="4dp"
                        app:tint="#EA580C" />
                </FrameLayout>

                <!-- FORMULARIO DE AJUSTE MANUAL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- ALERTA INFORMATIVA -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardBackgroundColor="#EFF6FF"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#BFDBFE"
                        app:strokeWidth="1dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:text="ℹ️ Atención: Para ingresar facturas de proveedores, usa el módulo de Abastecimiento."
                            android:textColor="#1E40AF"
                            android:textSize="12sp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- TIPO MOVIMIENTO -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Tipo de Movimiento *"
                        android:textColorHint="#64748B"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#CBD5E1"
                        app:boxStrokeWidth="1dp"
                        app:hintTextColor="#EA580C">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerTipoMovimiento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none"
                            android:paddingVertical="10dp"
                            android:textColor="#0F172A"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- PRODUCTO A AJUSTAR -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Producto a Ajustar *"
                        android:textColorHint="#64748B"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#CBD5E1"
                        app:boxStrokeWidth="1dp"
                        app:hintTextColor="#EA580C">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerProducto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none"
                            android:paddingVertical="10dp"
                            android:textColor="#0F172A"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- BODEGA ORIGEN/DESTINO -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBodega"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Bodega *"
                        android:textColorHint="#64748B"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#CBD5E1"
                        app:boxStrokeWidth="1dp"
                        app:hintTextColor="#EA580C">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerBodega"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none"
                            android:paddingVertical="10dp"
                            android:textColor="#0F172A"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- BODEGA DESTINO (SOLO TRANSFERENCIA) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBodegaDestino"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Bodega Destino *"
                        android:textColorHint="#64748B"
                        android:visibility="gone"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#CBD5E1"
                        app:boxStrokeWidth="1dp"
                        app:hintTextColor="#EA580C">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerBodegaDestino"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none"
                            android:paddingVertical="10dp"
                            android:textColor="#0F172A"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- STOCK DISPONIBLE -->
                    <TextView
                        android:id="@+id/tvStockDisponible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text=""
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="italic"
                        android:visibility="gone" />

                    <!-- CANTIDAD Y COSTO UNITARIO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:hint="Cantidad *"
                            android:textColorHint="#64748B"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="#CBD5E1"
                            app:boxStrokeWidth="1dp"
                            app:hintTextColor="#EA580C">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCantidadAjuste"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:paddingVertical="10dp"
                                android:textColor="#0F172A"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:hint="Costo U. ($)"
                            android:textColorHint="#64748B"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="#CBD5E1"
                            app:boxStrokeWidth="1dp"
                            app:hintTextColor="#EA580C"
                            app:prefixText="$ ">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCostoUnitarioAjuste"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:paddingVertical="10dp"
                                android:textColor="#0F172A"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- MOTIVO DEL AJUSTE -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Motivo del ajuste *"
                        android:textColorHint="#64748B"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#CBD5E1"
                        app:boxStrokeWidth="1dp"
                        app:hintTextColor="#EA580C">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMotivoAjuste"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:paddingVertical="10dp"
                            android:textColor="#0F172A"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- DOC. REFERENCIA -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Doc. Referencia (Opcional)"
                        android:textColorHint="#64748B"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#CBD5E1"
                        app:boxStrokeWidth="1dp"
                        app:hintTextColor="#EA580C">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDocReferenciaAjuste"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:paddingVertical="10dp"
                            android:textColor="#0F172A"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- BOTONES DE ACCIÓN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelarAjuste"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="Cancelar"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            app:cornerRadius="12dp"
                            app:strokeColor="#CBD5E1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegistrarAjuste"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:backgroundTint="#EA580C"
                            android:text="Registrar Ajuste"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>