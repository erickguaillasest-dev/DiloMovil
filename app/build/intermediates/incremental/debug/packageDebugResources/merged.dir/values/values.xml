        <item name="android:paddingBottom">14dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="CampoTexto">
        <item name="android:background">@drawable/bg_campo_entrada</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_texto_principal</item>
        <item name="android:textColorHint">@color/gris_400</item>
    </style>
    <style name="RegisterLabelStyle">
        <item name="android:textSize">12sp</item>
