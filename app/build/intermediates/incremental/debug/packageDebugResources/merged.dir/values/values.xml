    <style name="BotonOutline">
        <item name="android:background">@drawable/bg_boton_outline</item>
        <item name="android:textColor">@color/color_primario</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="BotonPrimario">
        <item name="android:background">@drawable/bg_boton_primario</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
