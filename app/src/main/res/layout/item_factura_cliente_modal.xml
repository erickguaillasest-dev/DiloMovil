<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- INFORMACIÓN PRINCIPAL (Nº FACTURA + FECHA VENCIMIENTO) -->
        <LinearLayout
            android:id="@+id/layoutInfoFactura"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layoutBadgeYSaldo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvNumFacturaModalItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="FAC-2026-0042" />

            <TextView
                android:id="@+id/tvFechaVencimientoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#64748B"
                android:textSize="12sp"
                tools:text="Vence: 15/09/2026" />
        </LinearLayout>

        <!-- BLOQUE CENTRAL: BADGE ESTADO + SALDO -->
        <LinearLayout
            android:id="@+id/layoutBadgeYSaldo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnAccionFacturaModal"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvBadgeEstadoModal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_outlined_box"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#D97706"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="PENDIENTE" />

            <TextView
                android:id="@+id/tvSaldoModalItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="$125.50" />
        </LinearLayout>

        <!-- BOTÓN DE ACCIÓN PRINCIPAL -->
        <Button
            android:id="@+id/btnAccionFacturaModal"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#F97316"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnEmailFacturaModal"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="PAGAR" />

        <!-- BOTÓN SECUNDARIO (EMAIL) -->
        <ImageButton
            android:id="@+id/btnEmailFacturaModal"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_outlined_box"
            android:contentDescription="Enviar Email"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_dialog_email"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#475569" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>