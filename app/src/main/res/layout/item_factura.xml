<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Cabecera: Número de Factura y Badge de Estado SRI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- numero_factura -->
            <TextView
                android:id="@+id/tvNumeroFactura"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="FAC-001-002" />

            <!-- estado_sri (Encapsulado en tarjeta para border-radius perfecto) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBadgeEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#DCFCE7"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textColor="#166534"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="AUTORIZADO" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Información del Cliente y Fecha de Emisión -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Nombre completo del cliente (clientes table) -->
            <TextView
                android:id="@+id/tvClienteNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#475569"
                android:textSize="13sp"
                tools:text="Juan Pérez (Consumidor Final)" />

            <!-- fecha_emision -->
            <TextView
                android:id="@+id/tvFechaEmision"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                tools:text="22/07/2026" />
        </LinearLayout>

        <!-- Divisor minimalista -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="#F1F5F9" />

        <!-- Pie de la Card: Método de Pago, Total Factura y Acción Descargar PDF -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- metodo_pago -->
            <TextView
                android:id="@+id/tvMetodoPago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#F1F5F9"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="EFECTIVO" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- total_factura -->
            <TextView
                android:id="@+id/tvTotalFactura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="$125.00" />

            <!-- Botón Descargar PDF / RIDE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnContainerPdf"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFF7ED"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="#FFEDD5"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/btnDescargarPdf"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Descargar PDF"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_save"
                    app:tint="#EA580C" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>