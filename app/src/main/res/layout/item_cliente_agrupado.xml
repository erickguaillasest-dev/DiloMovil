<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- FILA 1: AVATAR + NOMBRE + PENDIENTES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAvatarInicial"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_avatar_circulo"
                android:gravity="center"
                android:textColor="@android:color/holo_orange_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="M" />

            <!-- Acento decorativo entre avatar y nombre -->
            <View
                android:id="@+id/dividerGroup"
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:layout_marginHorizontal="10dp"
                android:background="#F97316" />

            <TextView
                android:id="@+id/tvNombreClienteGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="María González" />

            <TextView
                android:id="@+id/tvCuentasPendientesGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_outlined_box"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#DC2626"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="20 pend." />
        </LinearLayout>

        <!-- SEPARADOR -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#F1F5F9" />

        <!-- FILA 2: DEUDA TOTAL + BOTÓN VER -->
        <LinearLayout
            android:id="@+id/layoutTotalDeuda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deuda Total"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvTotalDeudaGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#EA580C"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="$21853.43" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerFacturasCliente"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="Ver"
                android:textAllCaps="false"
                android:textColor="#EA580C"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeColor="#FED7AA"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>