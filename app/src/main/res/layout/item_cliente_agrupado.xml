<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="12dp">

    <!-- Columna Cliente (Avatar + Nombre + Identificación) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAvatarInicial"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_avatar_circulo"
            android:gravity="center"
            android:text="M"
            android:textColor="@android:color/holo_orange_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNombreClienteGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Columna Facturas con Deuda -->
    <TextView
        android:id="@+id/tvCuentasPendientesGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:gravity="center"
        android:textColor="#DC2626"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Columna Deuda Total Consolidada -->
    <TextView
        android:id="@+id/tvTotalDeudaGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:gravity="end"
        android:paddingEnd="8dp"
        android:textColor="#EA580C"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Columna Acción -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerFacturasCliente"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingHorizontal="8dp"
            android:text="Ver Facturas del Cliente"
            android:textAllCaps="false"
            android:textColor="#475569"
            android:textSize="10sp"
            app:cornerRadius="20dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp" />
    </LinearLayout>
</LinearLayout>