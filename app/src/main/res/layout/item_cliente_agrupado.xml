<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- AVATAR DEL CLIENTE -->
        <TextView
            android:id="@+id/tvAvatarInicial"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@drawable/bg_avatar_circulo"
            android:gravity="center"
            android:textColor="@android:color/holo_orange_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintBottom_toBottomOf="@id/tvNombreClienteGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvNombreClienteGroup"
            tools:text="M" />

        <!-- NOMBRE DEL CLIENTE -->
        <TextView
            android:id="@+id/tvNombreClienteGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvCuentasPendientesGroup"
            app:layout_constraintStart_toEndOf="@id/tvAvatarInicial"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="María González" />

        <!-- CUENTAS PENDIENTES (BADGE) -->
        <TextView
            android:id="@+id/tvCuentasPendientesGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_outlined_box"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="#DC2626"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="3 facturas pendientes" />

        <!-- DIVISOR SUTIL -->
        <View
            android:id="@+id/dividerGroup"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#F1F5F9"
            app:layout_constraintTop_toBottomOf="@id/tvAvatarInicial" />

        <!-- SECCIÓN INFERIOR: TOTAL DEUDA -->
        <LinearLayout
            android:id="@+id/layoutTotalDeuda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnVerFacturasCliente"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerGroup">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deuda Total"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvTotalDeudaGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#EA580C"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="$450.00" />
        </LinearLayout>

        <!-- BOTÓN DE ACCIÓN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerFacturasCliente"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:text="Ver Facturas del Cliente"
            android:textAllCaps="false"
            android:textColor="#475569"
            android:textSize="11sp"
            app:cornerRadius="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerGroup"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>