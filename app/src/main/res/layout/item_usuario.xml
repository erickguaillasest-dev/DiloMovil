<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- CABECERA CON ETIQUETA DE ESTADO -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvEstadoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_chip_teal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="ACTIVO"
                android:textColor="#0D9488"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- AVATAR CIRCULAR GRANDE CENTRADO -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivAvatarUsuario"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_avatar_circulo"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <TextView
                android:id="@+id/tvIniciales"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_circulo"
                android:gravity="center"
                android:text="U"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- NOMBRE COMPLETO Y CORREO -->
        <TextView
            android:id="@+id/tvNombreCompleto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Nombre del Usuario"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="correo@dominio.com"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <!-- CAMPOS DNI Y TELÉFONO TIPO PASTILLA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_campo_entrada"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 "
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDni"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0102030405"
                    android:textColor="#334155"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_campo_entrada"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📞 "
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTelefono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0991234567"
                    android:textColor="#334155"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- BOTÓN 1: VER DETALLES COMPLETOS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerDetalles"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:text="👁️ Ver Detalles Completos"
            android:textAllCaps="false"
            android:textColor="#2563EB"
            android:textSize="13sp"
            app:backgroundTint="#EFF6FF"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            app:strokeWidth="0dp" />

        <!-- BOTÓN 2: SUSPENDER / ACTIVAR CUENTA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSuspender"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="⛔ Suspender Cuenta"
            android:textAllCaps="false"
            android:textColor="#DC2626"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:strokeColor="#FCA5A5"
            app:strokeWidth="1dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>