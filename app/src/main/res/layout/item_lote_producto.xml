<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- CABECERA: CÓDIGO E ID SISTEMA -->
        <LinearLayout
            android:id="@+id/layoutCodigoLote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@id/cardBadgeEstadoLote"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvCodigoLote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="LOTE-00020" />

            <TextView
                android:id="@+id/tvIdSistemaLote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#64748B"
                android:textSize="12sp"
                tools:text="ID Sistema: 56" />
        </LinearLayout>

        <!-- BADGE / ESTADO -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBadgeEstadoLote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#DCFCE7"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="#BBF7D0"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvEstadoLote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="#166534"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="VIGENTE" />
        </com.google.android.material.card.MaterialCardView>

        <!-- DIVISOR VISUAL -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#F1F5F9"
            app:layout_constraintTop_toBottomOf="@id/layoutCodigoLote" />

        <!-- BLOQUE SECUNDARIO: FECHAS -->
        <LinearLayout
            android:id="@+id/layoutFechas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/divider">

            <TextView
                android:id="@+id/tvFechaCreacionLote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#64748B"
                android:textSize="12sp"
                tools:text="Creado: 01/08/2026 11:41" />

            <TextView
                android:id="@+id/tvVencimientoLote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#64748B"
                android:textSize="12sp"
                tools:text="Vence: 01/08/2027" />
        </LinearLayout>

        <!-- PIE: CANTIDADES Y COSTO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/layoutFechas">

            <TextView
                android:id="@+id/tvCantidadInicialLote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#475569"
                android:textSize="13sp"
                tools:text="Inicial: 20" />

            <TextView
                android:id="@+id/tvCantidadDisponibleLote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:textColor="#16A34A"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Disponible: 14" />

            <TextView
                android:id="@+id/tvCostoUnitarioLote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="$8.98" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>