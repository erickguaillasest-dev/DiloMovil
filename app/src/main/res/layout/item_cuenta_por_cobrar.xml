<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardCuentaItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila Superior: Factura, Badge Recién Pagado y Badge Estado -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNumeroFactura"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#TEMP-01ABA54C"
                    android:textColor="#172A46"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBadgeRecienPagado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_pagado_reciente"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="💸 PAGADO"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="PENDIENTE"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Cliente y Fecha Vencimiento -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvClienteNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Cliente No Registrado"
                android:textColor="#475569"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvVencimientoGlobal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vence: 25/10/2026"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Contenedor de Montos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8FAFC"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monto Total"
                    android:textColor="#64748B"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvMontoTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$655.50"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#E2E8F0" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saldo Pendiente"
                    android:textColor="#64748B"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvSaldoPendiente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="#059669"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Acciones: Toggle Cuotas, Panel Cobranza, Botón Abonar y Recordatorio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleCuotas"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="74dp"
                android:layout_height="match_parent"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp"
                android:text="Ver (3)"
                android:textColor="#172A46"
                android:textSize="11sp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbrirPanelCobranza"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="83dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp"
                android:text="Panel"
                android:textColor="#EA580C"
                android:textSize="11sp"
                app:strokeColor="#EA580C"
                app:strokeWidth="1dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccionAbonar"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:backgroundTint="#ED8936"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Abonar"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:elevation="0dp" />

            <!-- BOTÓN DE RECORDATORIO -->
            <ImageButton
                android:id="@+id/btnEnviarRecordatorio"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_outlined_box"
                android:src="@android:drawable/ic_dialog_email"
                app:tint="#475569" />
        </LinearLayout>

        <!-- Acordeón Desplegable de Cuotas -->
        <LinearLayout
            android:id="@+id/containerCuotas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="DESGLOSE DE CUOTAS"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutListaCuotas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>